# ============================================================
# KONFIGURASI DATABASE VERCEL POSTGRES (SERVERLESS NEON)
# ============================================================
# Catatan: Variabel-variabel di bawah ini akan OTOMATIS di-generate 
# oleh Vercel saat Anda mengklik "Storage" -> "Connect Store" -> "Postgres" 
# di dashboard Vercel Anda. Tidak perlu diisi manual di Vercel!
#
# Untuk pengujian lokal (.env.local), copy variabel dari Dashboard Vercel:
# (Atau biarkan kosong, web akan otomatis berjalan dalam mode Mock/Simulasi)

POSTGRES_URL="postgres://default:xxx@ep-xxx-pooler.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require"
POSTGRES_PRISMA_URL="postgres://default:xxx@ep-xxx-pooler.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require&pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgres://default:xxx@ep-xxx.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require"
POSTGRES_USER="default"
POSTGRES_HOST="ep-xxx.us-east-1.postgres.vercel-storage.com"
POSTGRES_PASSWORD="xxx"
POSTGRES_DATABASE="verceldb"

